{
  "name": "proinspect-property-reports",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && bash scripts/ensureCloudflareResources.sh && wrangler d1 migrations apply proinspect-property-reports --remote && wrangler deploy",
    "infra:ensure": "bash scripts/ensureCloudflareResources.sh",
    "db:migrate:local": "wrangler d1 migrations apply proinspect-property-reports --local",
    "db:migrate:remote": "wrangler d1 migrations apply proinspect-property-reports --remote",
    "clean": "rm -rf dist .wrangler",
    "lint": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "db:backup": "mkdir -p backups && wrangler d1 export proinspect-property-reports --remote --output=./backups/proinspect-property-reports.sql",
    "pdf:verify": "bun run scripts/verifyPdfGenerator.ts",
    "api:verify": "bash scripts/verifyApiIntegration.sh",
    "security:verify": "bun audit --audit-level=high"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.2",
    "@cloudflare/workers-types": "^5.20260914.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.141.0"
  }
}
