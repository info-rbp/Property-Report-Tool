# Local development only. Copy this file to .dev.vars.
DEV_USER_EMAIL=local@proinspect.test
DEV_USER_ROLE=admin

# Production requests use Cloudflare Access instead.
# Configure TEAM_DOMAIN and POLICY_AUD as Worker variables/secrets in Cloudflare.
#
# Application authorization is layered on top of Cloudflare Access:
# DEFAULT_ROLE=editor
# ADMIN_EMAILS=admin1@example.com,admin2@example.com
# EDITOR_EMAILS=editor1@example.com,editor2@example.com
# VIEWER_EMAILS=viewer1@example.com
#
# Explicit email lists override DEFAULT_ROLE. Supported roles are:
# viewer = read/download only
# editor = create/edit/finalise/correct reports and edit properties
# admin  = editor permissions plus archive/restore properties


# Stage 2 ProInspect platform integration.
# The handoff signing key must match REPORT_HANDOFF_SIGNING_KEY in the main
# ProInspect application. The ingest token must match REPORT_INGEST_TOKEN.
PROINSPECT_HANDOFF_SIGNING_KEY=""
PROINSPECT_INGEST_URL="https://bookings.proinspect.systems/api/integrations/reports"
PROINSPECT_INGEST_TOKEN=""
