{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "proinspect-property-report-creation-tool",
  "main": "./worker/index.ts",
  "keep_vars": true,
  "compatibility_date": "2026-09-27",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "proinspect-property-reports",
      "database_id": "777186a0-e6ca-43f5-8f50-448bd4454046",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REPORT_STORAGE",
      "bucket_name": "proinspect-property-reports-data"
    },
    {
      "binding": "REPORT_RECOVERY_STORAGE",
      "bucket_name": "proinspect-property-reports-recovery"
    }
  ],
  "observability": {
    "enabled": true
  }
}
